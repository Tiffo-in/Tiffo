# These are BUILD-TIME values, not runtime config. Vite inlines them into the
# static bundle during `npm run build`, so setting them on the Cloud Run service
# has no effect — production values are passed as Docker --build-arg from the
# Cloud Build substitutions in cloudbuild.yaml. Everything here ends up readable
# in the public JS bundle, so no real secrets belong in this file.

REACT_APP_API_URL=http://localhost:5001/api
REACT_APP_SENTRY_DSN=
REACT_APP_GOOGLE_CLIENT_ID=1089107450487-fp7hptbu0euf9nivhgvj4es1sj2vi2il.apps.googleusercontent.com
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id